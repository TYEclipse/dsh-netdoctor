{
  "name": "dsh-netdoctor",
  "version": "0.4.0",
  "description": "Network diagnostics toolbox for DeepSeek Harness (dsh): DNS lookup (A/AAAA/CNAME/MX/TXT/NS/SOA/SRV/PTR/CAA), multi-resolver DNS propagation, ICMP ping, TCP port check, TLS certificate check, HTTP(S) check with redirect chain and per-phase timing (DNS/connect/TLS/TTFB/total), traceroute, WHOIS registry lookup, and public IP info — zero runtime dependencies",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint src test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "network",
    "diagnostics",
    "dns",
    "ping",
    "traceroute",
    "tls",
    "http",
    "redirect",
    "whois",
    "caa"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TYEclipse/dsh-netdoctor.git"
  },
  "bugs": {
    "url": "https://github.com/TYEclipse/dsh-netdoctor/issues"
  },
  "homepage": "https://github.com/TYEclipse/dsh-netdoctor#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "3.2.0",
    "oxlint": "^1.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
